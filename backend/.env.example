# Copy to .env before composer install. Local development only.
APP_ENV=dev
APP_DEBUG=1
# Generate your own value: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=replace-with-a-generated-local-value
DEFAULT_URI=http://127.0.0.1:8001
# Replace the password with your local MariaDB root password.
# Change serverVersion only if your MariaDB isn't 10.11.x, for example 10.6.0-MariaDB.
DATABASE_URL="mysql://root:your-local-db-password@127.0.0.1:3306/portal?serverVersion=10.11.0-MariaDB&charset=utf8mb4"
# Turn off email delivery.
MAILER_DSN=null://null
# Optional: where uploads are saved. Leave it out to use backend/var/uploads.
# UPLOAD_DIR=/path/outside/the/project

# Copy to .env before composer install. Local development only.
APP_ENV=dev
APP_DEBUG=1
# Generate your own value: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=replace-with-a-generated-local-value
DEFAULT_URI=http://127.0.0.1:8001
# Replace the password with your local MariaDB root password.
# Change serverVersion only if your MariaDB isn't 10.11.x, for example 10.6.0-MariaDB.
DATABASE_URL="mysql://root:your-local-db-password@127.0.0.1:3306/portal?serverVersion=10.11.0-MariaDB&charset=utf8mb4"
# Turn off email delivery. To read the sign-up emails locally, run Mailpit and use smtp://127.0.0.1:1025.
MAILER_DSN=null://null
# Optional: who account emails come from.
# MAILER_FROM="RebelHacks <info@rebelhacks.com>"
# Uploaded resumes are saved in backend/var/uploads. Optional: another folder.
# UPLOAD_DIR=/path/outside/the/project
# Optional: 0 shows hackers what the server shows before their pages open: one "you're registered" page, plus Settings.
# HACKER_PAGES_OPEN=0
# Servers keep them in S3 instead.
# UPLOAD_STORAGE=uploads.s3
# S3_BUCKET=
# S3_REGION=
JWT_SECRET_KEY=
JWT_PUBLIC_KEY=
JWT_PASSPHRASE=
CORS_ALLOW_ORIGIN=
CORS_ALLOWED_ORIGINS=

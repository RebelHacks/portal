{% extends 'base.html.twig' %}

{% set out = true %}

{% block title %}Set a new password{% endblock %}

{% block body %}
    {# Reached by logging in with an emailed link. Skipping keeps the old password. #}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--red)">
            {{ form_start(form, { action: path('app_password_new') }) }}
            <div class="panel-body">
                {{ form_errors(form) }}

                <div class="field">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                    <span class="soft">At least 8 characters with a capital, a number and a symbol. No spaces.</span>
                    <span class="error">{{ form_errors(form.plainPassword.first) }}</span>
                </div>
                <div class="field">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second) }}
                    <span class="error">{{ form_errors(form.plainPassword) }}</span>
                </div>
            </div>
            <div class="panel-actions">
                <button class="button" type="submit">Save password</button>
                <a class="soft" href="{{ path('app_lobby') }}">Skip for now</a>
            </div>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}

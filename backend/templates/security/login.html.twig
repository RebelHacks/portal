{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="relative z-[1] w-[clamp(280px,90vw,420px)] p-[clamp(1.5rem,5vw,2.5rem)] rounded-2xl bg-[#0f2c44] text-white shadow-[0_10px_40px_rgba(0,0,0,0.4)] flex flex-col items-center">

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold">
                    Welcome back
                </h1>
                <p class="mt-2 text-sm">
                    Sign in to access the portal
                </p>
            </div>

            <form method="post" class="w-full flex flex-col gap-4">
                <label for="username" class="flex flex-col text-base">
                    Email
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="w-full mt-2 p-[clamp(0.6rem,2vw,0.875rem)] text-[clamp(0.9rem,2vw,1rem)] box-border border-2 border-[#00ffff] bg-[#0d1b2a] text-white rounded-lg [text-shadow:0_0_2px_#00ffff] transition-all duration-300 focus:outline-none focus:border-[#ff7f50] focus:shadow-[0_0_5px_#ff7f50,0_0_10px_#ff7f50]"
                        autocomplete="email"
                        placeholder="Email"
                        required
                        autofocus
                    >
                </label>

                <label for="password" class="flex flex-col text-base">
                    Password
                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="w-full mt-2 p-[clamp(0.6rem,2vw,0.875rem)] text-[clamp(0.9rem,2vw,1rem)] box-border border-2 border-[#00ffff] bg-[#0d1b2a] text-white rounded-lg [text-shadow:0_0_2px_#00ffff] transition-all duration-300 focus:outline-none focus:border-[#ff7f50] focus:shadow-[0_0_5px_#ff7f50,0_0_10px_#ff7f50]"
                        autocomplete="current-password"
                        placeholder="Password"
                        required
                    >
                </label>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Remember me</label>
                    </div>
                #}

                <button
                    class="w-full mt-2 p-[clamp(0.8rem,2vw,1rem)] text-[clamp(1rem,2.5vw,1.2rem)] border-2 border-[#ff7f50] text-[#ff7f50] bg-transparent rounded-lg font-bold transition-all duration-300 cursor-pointer hover:bg-[#ff7f50] hover:text-[#0d1b2a] hover:shadow-[0_0_10px_#ff7f50,0_0_20px_#ff7f50]"
                    type="submit"
                >
                    Log In
                </button>
            </form>

            <div class="mt-4 flex flex-col items-center gap-2 text-sm">
                <button type="button" class="hover:underline cursor-pointer">
                    Forgot password?
                </button>

                <button type="button" class="hover:underline cursor-pointer">
                    Don't have an account? Register
                </button>
            </div>

        </div>
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% set out = true %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--red)">
            <header class="panel-tab"><h2>Welcome back</h2></header>
            <form method="post">
                <div class="panel-body">
                    {% if error %}
                        <p class="notice error" style="margin-bottom: 14px">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    {% endif %}
                    {% for message in app.flashes('success') %}
                        <p class="notice" style="margin-bottom: 14px">{{ message }}</p>
                    {% endfor %}

                    <div class="field">
                        <label for="username">University email</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" placeholder="student@unlv.nevada.edu" required autofocus>
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <input type="password" name="_password" id="password" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                </div>
                <div class="panel-actions">
                    <button class="button" type="submit">Log in</button>
                    {# TODO: login links (the design doc's /login/link) #}
                    <a class="soft" href="#">Forgot your password?</a>
                </div>
            </form>
        </section>

        <p class="meta center">New to RebelHacks? <a href="{{ path('app_register') }}">Register</a></p>
    </div>
{% endblock %}

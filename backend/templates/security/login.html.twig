{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="page-container">
        <div class="relative flex w-11/12 max-w-md flex-col items-center rounded-2xl bg-[#0f2c44] p-6 text-white shadow-[0_10px_40px_rgba(0,0,0,0.4)] sm:p-8 md:p-10">

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            <div class="mb-6 text-center">
                <h1 class="text-2xl font-bold">
                    Welcome back
                </h1>
                <p class="mt-2 text-sm">
                    Sign in to access the portal
                </p>
            </div>

            <form method="post" class="flex w-full flex-col gap-4">
                <label for="username" class="flex flex-col text-base">
                    Email
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="mt-2 w-full rounded-lg border-2 border-[#00ffff] bg-[#0d1b2a] p-3.5 text-base text-white [text-shadow:0_0_2px_#00ffff] transition duration-300 focus:border-[#ff7f50] focus:shadow-[0_0_5px_#ff7f50,0_0_10px_#ff7f50] focus:outline-none"
                        autocomplete="email"
                        placeholder="Email"
                        required
                        autofocus
                    >
                </label>

                <label for="password" class="flex flex-col text-base">
                    Password
                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="mt-2 w-full rounded-lg border-2 border-[#00ffff] bg-[#0d1b2a] p-3.5 text-base text-white [text-shadow:0_0_2px_#00ffff] transition duration-300 focus:border-[#ff7f50] focus:shadow-[0_0_5px_#ff7f50,0_0_10px_#ff7f50] focus:outline-none"
                        autocomplete="current-password"
                        placeholder="Password"
                        required
                    >
                </label>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Remember me</label>
                    </div>
                #}

                <button
                    class="mt-2 w-full cursor-pointer rounded-lg border-2 border-[#ff7f50] bg-transparent p-4 text-lg font-bold text-[#ff7f50] transition duration-300 hover:bg-[#ff7f50] hover:text-[#0d1b2a] hover:shadow-[0_0_10px_#ff7f50,0_0_20px_#ff7f50]"
                    type="submit"
                >
                    Log In
                </button>
            </form>

            <div class="mt-4 flex flex-col items-center gap-2 text-sm">
                <button type="button" class="hover:underline cursor-pointer">
                    Forgot password?
                </button>

                <button type="button" class="hover:underline cursor-pointer">
                    Don't have an account? Register
                </button>
            </div>

        </div>
    </div>
{% endblock %}

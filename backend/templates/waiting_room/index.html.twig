{% extends 'base.html.twig' %}

{% set out = true %}
{% set opensAt = hackathon ? hackathon.registrationOpensAt : null %}

{% block title %}{% if opensAt %}Registration opens {{ opensAt|date('F j') }}{% else %}Registration isn't open yet{% endif %}{% endblock %}

{% block body %}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--gold); --on-c: #141414">
            <div class="panel-body">
                {% if opensAt %}
                    {# shell.js counts down and reloads when the server should open registration. #}
                    <p class="countdown" data-countdown="{{ opensAt.timestamp - date().timestamp }}">{{ opensAt|date('F j') }}</p>
                    <p class="meta">
                        Registration opens {{ opensAt|date('l, F j') }} at {{ opensAt|date('g:i A') }}.
                        {{ hackathon.name }} takes place {{ hackathon.startsAt|date('F j') }}–{{ hackathon.endsAt|date('F j, Y') }} at UNLV.
                    </p>
                {% else %}
                    <p class="meta">Check rebelhacks.com for the registration opening date.</p>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}

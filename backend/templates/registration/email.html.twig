{% extends 'base.html.twig' %}

{% set out = true %}

{% block title %}Register for RebelHacks{% endblock %}

{% block body %}
    {# Step 1: the signed email link will carry all three validated fields. #}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--red)">
            {{ form_start(form, { action: path('app_register') }) }}
            <div class="panel-body">
                {% for message in app.flashes('error') %}
                    <p class="notice error" style="margin-bottom: 14px">{{ message }}</p>
                {% endfor %}
                {{ form_errors(form) }}

                <div class="buttons">
                    <div style="flex: 1; min-width: 150px" class="field">
                        {{ form_label(form.firstName) }}
                        {{ form_widget(form.firstName) }}
                        <span class="error">{{ form_errors(form.firstName) }}</span>
                    </div>
                    <div style="flex: 1; min-width: 150px" class="field">
                        {{ form_label(form.lastName) }}
                        {{ form_widget(form.lastName) }}
                        <span class="error">{{ form_errors(form.lastName) }}</span>
                    </div>
                </div>

                <div class="field">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    <span class="soft">Use a .edu email address from any college. We'll send you a link to continue.</span>
                    <span class="error">{{ form_errors(form.email) }}</span>
                </div>
            </div>
            <div class="panel-actions">
                <button class="button" type="submit">Email me the link</button>
            </div>
            {{ form_end(form) }}
        </section>

        <p class="meta center">Already have an account? <a href="{{ path('app_login') }}">Log in</a></p>
    </div>
{% endblock %}

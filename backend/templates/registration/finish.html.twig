{% extends 'base.html.twig' %}

{% set out = true %}

{% macro field(field, help = null) %}
    <div class="field">
        {{ form_label(field) }}
        {{ form_widget(field) }}
        {% if help %}<span class="soft">{{ help }}</span>{% endif %}
        <span class="error">{{ form_errors(field) }}</span>
    </div>
{% endmacro %}
{% import _self as f %}

{% block title %}Finish registering{% endblock %}

{% block body %}
    {# Step 2: all of the fields shown as verified come from the signed link. #}
    {{ form_start(registrationForm, { action: path('app_register_finish') }) }}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--red)">
            <header class="panel-tab"><h2>Your account</h2></header>
            <div class="panel-body">
                {{ form_errors(registrationForm) }}

                <div class="field">
                    <label>University email</label>
                    <span class="mono">{{ email }}</span>
                </div>
                <div class="field">
                    <label>Name</label>
                    <span>{{ firstName }} {{ lastName }}</span>
                </div>

                {{ f.field(registrationForm.plainPassword.first, 'At least 8 characters with a capital, a number and a symbol. No spaces.') }}
                {{ f.field(registrationForm.plainPassword.second) }}
                <span class="error">{{ form_errors(registrationForm.plainPassword) }}</span>
            </div>
        </section>

        <section class="panel" style="--c: var(--blue)">
            <header class="panel-tab"><h2>About you</h2></header>
            <div class="panel-body">
                {{ f.field(registrationForm.school, 'Start typing to search. If your school is not suggested, enter its full name.') }}
                {{ include('registration/_school_suggestions.html.twig') }}

                {{ f.field(registrationForm.major) }}
                <div data-other-field-for="{{ registrationForm.major.vars.id }}">
                    {{ f.field(registrationForm.otherMajor) }}
                </div>

                <div class="field">
                    <label>{{ registrationForm.attendedBefore.vars.label }}</label>
                    <div class="radios">
                        {% for choice in registrationForm.attendedBefore %}
                            <label class="radio">
                                {{ form_widget(choice) }}
                                <span><b>{{ choice.vars.label }}</b>
                                    {%- if choice.vars.value == '0' %}<small>You can join the Beginner track.</small>{% else %}<small>Other hackathons don't count, only RebelHacks.</small>{% endif -%}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                    <span class="error">{{ form_errors(registrationForm.attendedBefore) }}</span>
                </div>

                {{ f.field(registrationForm.resume, 'PDF, up to 10 MB. Sponsors receive it for recruiting, and we delete it a year after the event.') }}

                <label class="check">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    <span>I agree to the <a href="{{ path('app_terms') }}" target="_blank" rel="noopener noreferrer">registration terms</a>.</span>
                </label>
                <span class="error">{{ form_errors(registrationForm.agreeTerms) }}</span>
            </div>
            <div class="panel-actions">
                <button class="button" type="submit">Create my account</button>
            </div>
        </section>
    </div>
    {{ form_end(registrationForm) }}

    {# Progressive enhancement: without JS, both text boxes remain available. #}
    <script>
        for (const container of document.querySelectorAll('[data-other-field-for]')) {
            const select = document.getElementById(container.dataset.otherFieldFor);
            const input = container.querySelector('input');
            if (!select || !input) continue;

            const update = () => {
                const selectedOther = select.value === 'Other';
                container.hidden = !selectedOther;
                input.required = selectedOther;
                if (!selectedOther) input.value = '';
            };

            select.addEventListener('change', update);
            update();
        }
    </script>
{% endblock %}

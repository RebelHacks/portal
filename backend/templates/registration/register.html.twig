{% extends 'base.html.twig' %}

{% macro input(field, inputClass)  %}
    <div>
        {{ form_label(field, null, {
            label_attr: {
                class: 'block mb-2 text-sm font-medium'
            }
        })  }}

        {{ form_widget(field, {
            attr: {
                class:inputClass
            }
        })  }}

        <div class="mt-1 text-sm text-red-300">
            {{ form_errors(field)  }}
        </div>
    </div>
{% endmacro %}

{% import _self as fields %}

{% block title %}Register | RebelHacks{% endblock %}

{% block body %}
    <main class="min-h-screen px-4 py-10">
        <div class="mx-auto w-full max-w-lg rounded-2xl bg-[#0f2c44] p-6 text-white shadow-2xl sm:p-8">
            <div class="mb-8 text-center">
                <h1 class="text-3xl font-bold">
                    Create an Account
                </h1>

                <p class="mt-2 text-sm text-gray-300">
                    Register for RebelHacks
                </p>
            </div>

            {% for error in app.flashes('verify_email_error') %}
                <div class="mb-4 rounded-lg bg-red-500/20 p-3 text-red-300">
                    {{ error }}
                </div>
            {% endfor %}

            {% set inputClass = 'w-full rounded-lg border-2 border-cyan-400 bg-[#0d1b2a] p-3 text-white outline-none transition focus:border-orange-400' %}

            {{ form_start(registrationForm, {
                action: path('app_register'),
                attr: {
                    class: 'space-y-8'
                }
            }) }}

            {{ form_errors(registrationForm) }}

            <section class="space-y-4">
                <h2 class="mb-5 border-b border-slate-600 pb-3 text-xl font-semibold text-white">
                    Account Information
                </h2>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {{ fields.input(registrationForm.firstName, inputClass) }}
                    {{ fields.input(registrationForm.lastName, inputClass) }}
                </div>

                {{ fields.input(registrationForm.email, inputClass) }}

                <div class="space-y-4">
                    {{ fields.input(registrationForm.plainPassword.first, inputClass) }}
                    {{ fields.input(registrationForm.plainPassword.second, inputClass) }}
                </div>

                <div class="text-sm text-red-300">
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>
                <p class="text-xs text-gray-300">
                    Use at least 8 characters, including uppercase,
                    lowercase, a number, and a special character.
                    No whitespace.
                </p>
            </section>

            <section class="mt-8 space-y-4 border-t border-slate-600 pt-6">
                <h2 class="text-xl font-semibold text-white">
                    Hackathon Information
                </h2>

                {{ fields.input(registrationForm.major, inputClass) }}

                <div>
                    {{ form_label(registrationForm.resume, null, {
                        label_attr: {
                            class: 'block mb-2 text-sm font-medium'
                        }
                    }) }}

                    {{ form_widget(registrationForm.resume, {
                        attr: {
                            accept: '.pdf, application/pdf',
                            class: 'w-full rounded-lg border border-cyan-400 bg-[#0d1b2a] p-3 text-sm text-white file:mr-4 file:rounded-lg file:border-0 file:bg-cyan-400 file:px-4 file:py-2 file:font-semibold file:text-[#0d1b2a]'
                        }
                    }) }}

                    <p class="mt-2 text-xs text-gray-300">
                        Optional. PDF only, maximum 10 MB.
                    </p>

                    <div class="text-sm text-red-300">
                        {{ form_errors(registrationForm.resume) }}
                    </div>
                </div>
            </section>

            <div>
                <div class="flex items-center gap-3 text-sm">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms, 'I agree to the registration terms') }}
                </div>

                <div class="mt-1 text-sm text-red-300">
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>
            </div>

            <button
                type="submit"
                class="w-full rounded-lg border-2 border-[#ff7f50] p-4 text-lg font-bold text-[#ff7f50] transition hover:bg-[#ff7f50] hover:text-[#0d1b2a]"
            >
                Create Account
            </button>

            {{ form_end(registrationForm) }}

            <p class="mt-6 text-center text-sm">
                Already have an account?

                <a href="{{ path('app_login') }}"
                    class="text-cyan-400 hover:underline">
                    Log in
                </a>
            </p>
        </div>
    </main>
{% endblock %}

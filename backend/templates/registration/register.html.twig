{% extends 'base.html.twig' %}

{% set out = true %}

{# A labelled field with its errors under it. #}
{% macro field(field, help = null) %}
    <div class="field">
        {{ form_label(field) }}
        {{ form_widget(field) }}
        {% if help %}<span class="soft">{{ help }}</span>{% endif %}
        <span class="error">{{ form_errors(field) }}</span>
    </div>
{% endmacro %}
{% import _self as f %}

{% block title %}Register for RebelHacks{% endblock %}

{% block body %}
    {# One step for now. The two-step email-first flow (see the design doc) replaces this. #}
    {{ form_start(registrationForm, { action: path('app_register') }) }}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--red)">
            <header class="panel-tab"><h2>Your account</h2></header>
            <div class="panel-body">
                {% for error in app.flashes('verify_email_error') %}
                    <p class="notice error" style="margin-bottom: 14px">{{ error }}</p>
                {% endfor %}
                {{ form_errors(registrationForm) }}

                <div class="buttons">
                    <div style="flex: 1">{{ f.field(registrationForm.firstName) }}</div>
                    <div style="flex: 1">{{ f.field(registrationForm.lastName) }}</div>
                </div>
                {{ f.field(registrationForm.email, 'A .edu address from any college.') }}
                {{ f.field(registrationForm.plainPassword.first, 'At least 8 characters with a capital, a number and a symbol. No spaces.') }}
                {{ f.field(registrationForm.plainPassword.second) }}
                <span class="error">{{ form_errors(registrationForm.plainPassword) }}</span>
            </div>
        </section>

        <section class="panel" style="--c: var(--blue)">
            <header class="panel-tab"><h2>About you</h2></header>
            <div class="panel-body">
                {{ f.field(registrationForm.school, 'Any college or university.') }}
                {{ f.field(registrationForm.major) }}

                <div class="field">
                    <label>{{ registrationForm.attendedBefore.vars.label }}</label>
                    <div class="radios">
                        {% for choice in registrationForm.attendedBefore %}
                            <label class="radio">
                                {{ form_widget(choice) }}
                                <span><b>{{ choice.vars.label }}</b>
                                    {%- if choice.vars.value == '0' %}<small>You can join the Beginner track.</small>{% else %}<small>Other hackathons don't count, only RebelHacks.</small>{% endif -%}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                    <span class="error">{{ form_errors(registrationForm.attendedBefore) }}</span>
                </div>

                {# Required once uploads go to S3. RegistrationController says how to turn it on.
                {{ f.field(registrationForm.resume, 'Required. PDF up to 10 MB. Sponsors get it for recruiting; deleted a year after the event.') }}
                #}

                <label class="check">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {# opens in a new tab so the form keeps what they typed #}
                    <span>I agree to the <a href="{{ path('app_terms') }}" target="_blank">registration terms</a>.</span>
                </label>
                <span class="error">{{ form_errors(registrationForm.agreeTerms) }}</span>
            </div>
            <div class="panel-actions">
                <button class="button" type="submit">Create my account</button>
                <a class="soft" href="{{ path('app_login') }}">Already have an account? Log in</a>
            </div>
        </section>
    </div>
    {{ form_end(registrationForm) }}
{% endblock %}

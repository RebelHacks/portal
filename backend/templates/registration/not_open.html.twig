{% extends 'base.html.twig' %}

{% set out = true %}

{% block title %}{% if hackathon and now < hackathon.registrationOpensAt %}Registration opens soon{% else %}Registration is closed{% endif %}{% endblock %}

{% block body %}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--gold); --on-c: #141414">
            <div class="panel-body">
                {% if hackathon and now < hackathon.registrationOpensAt %}
                    <p class="big-name">{{ hackathon.registrationOpensAt|date('l, F j \\a\\t g:i A') }}</p>
                    <p class="meta">Las Vegas time. {{ hackathon.name }} is {{ hackathon.startsAt|date('F j') }}–{{ hackathon.endsAt|date('j') }} at UNLV.</p>
                {% elseif hackathon %}
                    <p class="big-name">Sign-ups for {{ hackathon.name }} have closed.</p>
                {% else %}
                    <p class="big-name">Nothing to sign up for yet.</p>
                    <p class="meta">Check rebelhacks.com for the next date.</p>
                {% endif %}
            </div>
            <div class="panel-actions"><a class="soft" href="https://rebelhacks.com">&larr; rebelhacks.com</a></div>
        </section>
    </div>
{% endblock %}

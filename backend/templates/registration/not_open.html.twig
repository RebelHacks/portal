{% extends 'base.html.twig' %}

{% block title %}Register | RebelHacks{% endblock %}

{% block body %}
    <main class="min-h-screen px-4 py-10">
        <div class="mx-auto w-full max-w-lg rounded-2xl bg-[#0f2c44] p-6 text-center text-white shadow-2xl sm:p-8">
            {% if hackathon and now < hackathon.registrationOpensAt %}
                <h1 class="text-3xl font-bold">
                    Registration opens soon
                </h1>
                <p class="mt-4 text-gray-300">
                    Sign-ups for {{ hackathon.name }} open {{ hackathon.registrationOpensAt|date('l, F j \\a\\t g:i A') }}, Las Vegas time.
                </p>
            {% elseif hackathon %}
                <h1 class="text-3xl font-bold">
                    Registration is closed
                </h1>
                <p class="mt-4 text-gray-300">
                    Sign-ups for {{ hackathon.name }} have closed.
                </p>
            {% else %}
                <h1 class="text-3xl font-bold">
                    Registration isn't open yet
                </h1>
            {% endif %}

            <p class="mt-6 text-sm">
                Already have an account?
                <a href="{{ path('app_login') }}" class="text-cyan-400 hover:underline">Log in</a>
            </p>
        </div>
    </main>
{% endblock %}

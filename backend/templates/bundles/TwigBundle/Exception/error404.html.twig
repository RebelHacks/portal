{% extends 'base.html.twig' %}

{% block title %}Page not found{% endblock %}

{% block body %}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--ink-soft)">
            <div class="panel-body">
                <p class="meta">There's nothing at this address. If you followed a link, it may be old.</p>
            </div>
            <div class="panel-actions"><a class="button" href="{{ app.user ? path('app_lobby') : path('app_login') }}">{{ app.user ? 'Home' : 'Log in' }}</a></div>
        </section>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Lobby | RebelHacks{% endblock %}

{% block body %}
    <main class="lobby-container">
        <section class="w-full max-w-lg rounded-2xl bg-[#0f2c44] p-6 text-center text-white shadow-2xl sm:p-8">
            <h1 class="text-3xl font-bold">{% if name %}Welcome, {{ name }}!{% else %}Welcome!{% endif %}</h1>
            <p class="mt-4 text-lg">Thank you for registering for RebelHacks!</p>
            <p class="mt-2 text-gray-300">You will receive an email with more information.</p>

            <dl class="mt-8 space-y-4">
                <div>
                    <dt class="text-sm font-medium text-gray-300">Major</dt>
                    <dd class="text-lg">{{ major }}</dd>
                </div>
            </dl>

            <a href="{{ logout_path() }}" class="mt-8 inline-block rounded-lg border-2 border-[#ff7f50] px-6 py-3 font-bold text-[#ff7f50] transition hover:bg-[#ff7f50] hover:text-[#0d1b2a]">
                Log out
            </a>
        </section>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Lobby | RebelHacks{% endblock %}

{% block body %}
    <main class="min-h-screen px-4 py-10">
        <section class="mx-auto w-full max-w-lg rounded-2xl bg-[#0f2c44] p-6 text-white shadow-2xl sm:p-8">
            <h1 class="mb-6 text-3xl font-bold">Lobby</h1>

            <dl class="space-y-4">
                <div>
                    <dt class="text-sm font-medium text-gray-300">Name</dt>
                    <dd class="text-lg">{{ name }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-300">Major</dt>
                    <dd class="text-lg">{{ major }}</dd>
                </div>
            </dl>
        </section>
    </main>
{% endblock %}

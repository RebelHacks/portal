{% extends 'base.html.twig' %}

{# The lobby while the hacker pages are shut (HACKER_PAGES_OPEN): where their registration stands, and nothing to click. #}

{% block title %}{{ hackathon ? hackathon.name : 'RebelHacks' }}{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p class="notice">{{ message }}</p>
    {% endfor %}
    <div class="grid narrow">
        <section class="panel" style="--c: var(--red)">
            <div class="panel-body">
                {% if application is null %}
                    <p class="big-name">Not registered</p>
                    <p class="meta">This account has no registration for {{ hackathon ? hackathon.name : 'this RebelHacks' }}.</p>
                {% elseif application.status.value == 'pending' %}
                    <p class="big-name">Application pending</p>
                    <p class="meta">
                        Your application has been submitted successfully.
                        Please wait for the RebelHacks organizers
                        to review and approve your application.
                    </p>
                {% elseif application.status.value == 'waitlisted' %}
                    <p class="big-name">You're on the waitlist</p>
                    <p class="meta">Spots will open as people drop out, in the order your application got sent in. We'll email {{ app.user.email }} the moment a spot opens up for you!</p>
                {% else %}
                    <p class="big-name">You're registered!</p>
                    <p class="meta">All you need to do now is to wait for us to approve your application.</p>
                    <p class="meta">{{ hackathon.name }} is {{ hackathon.startsAt|date('F j') }}–{{ hackathon.endsAt|date('j') }} at UNLV. Teams, the schedule and project submission will open here before the event.</p>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}

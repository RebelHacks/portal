
{#
    Resume picker - Styled file input which shows the file name selected

    How to use:
        {{ include('components/resume_picker.html.twig', { name: 'resume' }, with_context = false) }}
        my example was previously inserted into  register.html.twig right below the submit button around line 37
    Parameters:
        name     the name of the field only mandatory parameter
        id       What the label points at. Must be unique defaults to name
        label    name of the label (the words above the box, defaults to resume)
        accept   Filters the type of file allowed, defaults to .pdf
        required Bool, True means a file needs to be submitted before proceeeding. False means the opposite. defaults to false
#}


{%set id = id|default(name)%}
{%set label = label|default('Resume') %}
{%set accept = accept|default('.pdf') %}
{%set required = required|default(false)%}

{#Input class originated on templates/registration/register.html.twig on line #19 It is the style used for the other buttons in the registration page#}
{% set input_class = 'mt-2 w-full rounded-lg border-2 border-[#00ffff] bg-[#0d1b2a] p-3.5 text-base text-white [text-shadow:0_0_2px_#00ffff] transition duration-300 focus:border-[#ff7f50] focus:shadow-[0_0_5px_#ff7f50,0_0_10px_#ff7f50] disabled:opacity-50 focus:outline-none disabled:cursor-not-allowed' %}

<div class="flex flex-col text-base">
    <label for="{{id}}"> {{label}} </label>
    <input id="{{id}}" type="file" accept="{{accept}}" name="{{name}}"{% if required %} required{% endif %} class="{{ input_class }} cursor-pointer file:mr-4 file:rounded-md file:border-0 file:bg-cyan-500 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-cyan-600">
    {# "File:mr-4" and onwards styles the 'choose file' button. Style was derived "frontend/app/register/page.tsx" at the transcript file handler section. Aprox line 133  #}
</div>
